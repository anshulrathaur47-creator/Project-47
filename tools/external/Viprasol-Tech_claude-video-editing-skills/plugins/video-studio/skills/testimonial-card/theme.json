{
  "name": "testimonial-card",
  "format": "4:5",
  "defaultDuration": 8,
  "fontsUrl": "https://fonts.googleapis.com/css2?family=Outfit:wght@500;700;800&display=swap",
  "vars": {
    "--font-display": "'Outfit',sans-serif",
    "--c-bg": "#0F172A",
    "--c-accent": "#6366F1",
    "--c-accent2": "#22D3EE"
  },
  "speaker": {
    "mode": "none"
  },
  "matte": false,
  "auto": {
    "static": [
      {
        "type": "background",
        "kind": "mesh"
      },
      {
        "type": "shape",
        "kind": "frame",
        "layer": "front",
        "className": "tc-panel",
        "x": "=W/2",
        "y": "=H/2",
        "w": "=W*0.86",
        "h": "=H*0.7",
        "color": "transparent",
        "in": "zoomIn"
      },
      {
        "type": "image",
        "image": "{image}",
        "className": "tc-avatar",
        "x": "=W/2",
        "y": "=H*0.24",
        "w": 180,
        "h": 180,
        "start": 0.3,
        "in": "pop"
      },
      {
        "type": "stars",
        "x": "=W/2",
        "y": "=H*0.36",
        "start": 0.6
      },
      {
        "type": "text",
        "text": "{title}",
        "className": "tc-quote",
        "split": "words",
        "stagger": 0.05,
        "unitIn": "rise",
        "wrap": true,
        "in": "none",
        "x": "=W/2",
        "y": "=H*0.55",
        "w": "=W*0.74",
        "start": 1.1
      },
      {
        "type": "text",
        "text": "{cta}",
        "className": "tc-name",
        "x": "=W/2",
        "y": "=H*0.77",
        "start": 3.0,
        "in": "rise"
      }
    ]
  },
  "sfx": [
    {
      "t": 0.6,
      "kind": "ding",
      "gain": 0.3
    }
  ],
  "finish": {
    "grade": "none"
  },
  "fps": 30
}