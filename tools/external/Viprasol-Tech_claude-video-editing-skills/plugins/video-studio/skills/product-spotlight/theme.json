{
  "name": "product-spotlight",
  "format": "9:16",
  "defaultDuration": 10,
  "fontsUrl": "https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;800&display=swap",
  "vars": {
    "--font-display": "'Plus Jakarta Sans',sans-serif",
    "--c-bg": "#EDEAE4",
    "--c-accent": "#111111",
    "--c-accent2": "#FF5C00",
    "--c-mark": "#111"
  },
  "speaker": {
    "mode": "none"
  },
  "matte": false,
  "auto": {
    "static": [
      {
        "type": "background",
        "kind": "solid"
      },
      {
        "type": "shape",
        "kind": "spotlight",
        "layer": "behind",
        "x": "=W/2",
        "y": "=H*0.5",
        "w": "=W*1.2",
        "h": "=W*1.2",
        "className": "ps-spot"
      },
      {
        "type": "image",
        "image": "{image}",
        "className": "ps-prod",
        "motion": "float",
        "x": "=W/2",
        "y": "=H*0.5",
        "w": "=W*0.7",
        "h": "=W*0.8",
        "start": 0.3,
        "in": "zoomIn",
        "inDur": 0.8
      },
      {
        "type": "text",
        "text": "{title}",
        "className": "ps-title",
        "x": "=W/2",
        "y": "=H*0.13",
        "w": "=W*0.88",
        "start": 0.6,
        "in": "rise",
        "fit": true
      }
    ],
    "endcard": {
      "dur": 2,
      "cta": "Shop now",
      "element": {
        "type": "chip",
        "text": "{cta}",
        "className": "ps-cta",
        "y": "=H*0.86",
        "in": "pop"
      }
    }
  },
  "finish": {
    "grade": "none"
  },
  "fps": 30
}