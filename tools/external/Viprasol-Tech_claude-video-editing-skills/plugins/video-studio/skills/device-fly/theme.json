{
  "name": "device-fly",
  "format": "9:16",
  "defaultDuration": 12,
  "maxDuration": 20,
  "fontsUrl": "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Unbounded:wght@700;900&display=swap",
  "vars": {
    "--font-display": "'Unbounded','Arial Black',sans-serif",
    "--font-body": "'Space Grotesk',Arial,sans-serif",
    "--c-bg": "#0B0820",
    "--c-accent": "#6C5CE7",
    "--c-accent2": "#00D2FF"
  },
  "speaker": {
    "mode": "none"
  },
  "matte": false,
  "auto": {
    "static": [
      {
        "type": "background",
        "kind": "mesh"
      },
      {
        "type": "shape",
        "kind": "glow",
        "layer": "behind",
        "x": "=W/2",
        "y": "=H*0.56",
        "w": "=W*1.2",
        "h": "=W*1.2",
        "color": "var(--c-accent2)"
      },
      {
        "type": "clip",
        "clip": "main",
        "device": "phone",
        "motion": "flyIn",
        "x": "=W/2",
        "y": "=H*0.57",
        "w": "=W*0.58",
        "h": "=W*0.58*2.08",
        "start": 0.3,
        "end": "=DUR-1.8",
        "in": "fade",
        "inDur": 0.2
      },
      {
        "type": "image",
        "image": "{image}",
        "device": "phone",
        "motion": "flyIn",
        "x": "=W/2",
        "y": "=H*0.57",
        "w": "=W*0.58",
        "h": "=W*0.58*2.08",
        "start": 0.3,
        "end": "=DUR-1.8"
      },
      {
        "type": "text",
        "text": "{title}",
        "className": "df-title",
        "split": "words",
        "stagger": 0.08,
        "unitIn": "rise",
        "in": "none",
        "x": "=W/2",
        "y": "=H*0.12",
        "w": "=W*0.9",
        "start": 0.2,
        "end": "=DUR-1.8"
      }
    ],
    "captions": {
      "type": "captions",
      "mode": "karaoke",
      "maxWords": 4,
      "y": "=H*0.93",
      "className": "cap-pill"
    },
    "endcard": {
      "dur": 1.8,
      "element": {
        "type": "text",
        "text": "{cta}",
        "className": "df-cta",
        "x": "=W/2",
        "y": "=H/2",
        "in": "pop"
      }
    }
  },
  "sfx": [
    {
      "t": 0.35,
      "kind": "whoosh",
      "gain": 0.6
    }
  ],
  "finish": {
    "grade": "none"
  },
  "fps": 30
}