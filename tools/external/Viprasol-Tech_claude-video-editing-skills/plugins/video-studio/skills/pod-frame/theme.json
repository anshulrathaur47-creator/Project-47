{
  "name": "pod-frame",
  "format": "16:9",
  "fontsUrl": "https://fonts.googleapis.com/css2?family=Inter:wght@500;700;900&family=DM+Serif+Display&display=swap",
  "vars": {
    "--font-display": "'Inter',sans-serif",
    "--c-accent": "#FF5A36",
    "--c-accent2": "#FFD166",
    "--cap-size": "46px",
    "--c-card": "rgba(10,10,12,.85)"
  },
  "speaker": {
    "mode": "full"
  },
  "matte": false,
  "auto": {
    "static": [
      {
        "type": "text",
        "text": "{title}",
        "className": "pf-logo",
        "x": 60,
        "y": 60,
        "anchor": "top-left",
        "in": "fade"
      },
      {
        "type": "equalizer",
        "x": "=W-200",
        "y": 90,
        "w": 220,
        "h": 60,
        "count": 14,
        "in": "fade"
      }
    ],
    "captions": {
      "type": "captions",
      "mode": "karaoke",
      "maxWords": 6,
      "maxChars": 40,
      "y": "=H*0.88",
      "className": "cap-box pf-cap"
    },
    "hook": {
      "dur": 3.2,
      "element": {
        "type": "lowerthird",
        "name": "{text}",
        "role": "",
        "in": "slideRight"
      }
    }
  },
  "finish": {
    "grade": "warm"
  },
  "fps": 30
}