{
  "name": "event-promo",
  "format": "9:16",
  "defaultDuration": 10,
  "fontsUrl": "https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@800;900&family=Inter:wght@700&display=swap",
  "vars": {
    "--font-display": "'Big Shoulders Display','Impact',sans-serif",
    "--c-bg": "#120A1F",
    "--c-accent": "#FF4D00",
    "--c-accent2": "#7C3AED"
  },
  "speaker": {
    "mode": "none"
  },
  "matte": false,
  "auto": {
    "static": [
      {
        "type": "background",
        "kind": "mesh"
      },
      {
        "type": "shape",
        "kind": "grid",
        "layer": "behind",
        "x": "=W/2",
        "y": "=H/2",
        "w": "=W",
        "h": "=H",
        "color": "rgba(255,255,255,.25)"
      },
      {
        "type": "text",
        "text": "{title}",
        "className": "ep-title",
        "split": "chars",
        "stagger": 0.04,
        "unitIn": "drop",
        "in": "none",
        "fit": true,
        "wrap": true,
        "x": "=W/2",
        "y": "=H*0.36",
        "w": "=W*0.9",
        "start": 0.5,
        "end": "=DUR-2"
      }
    ],
    "endcard": {
      "dur": 2,
      "cta": "Register now",
      "element": {
        "type": "text",
        "text": "{cta}",
        "className": "ep-cta",
        "y": "=H/2",
        "in": "pop"
      }
    }
  },
  "sfx": [
    {
      "t": 0.0,
      "kind": "riser",
      "gain": 0.5
    },
    {
      "t": 0.5,
      "kind": "boom",
      "gain": 0.6
    }
  ],
  "finish": {
    "grade": "none",
    "grain": 4
  },
  "fps": 30
}