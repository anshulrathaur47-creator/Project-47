{
  "name": "soft-gradient",
  "format": "9:16",
  "fontsUrl": "https://fonts.googleapis.com/css2?family=DM+Sans:wght@500;700&display=swap",
  "vars": {
    "--font-display": "'DM Sans',sans-serif",
    "--c-bg": "#FCE7F3",
    "--c-accent": "#C4B5FD",
    "--c-accent2": "#99F6E4",
    "--cap-size": "54px",
    "--cap-weight": "700"
  },
  "speaker": {
    "mode": "panel",
    "rectFrac": [
      0.07,
      0.12,
      0.86,
      0.62
    ],
    "radius": 64,
    "focusY": 0.3
  },
  "matte": false,
  "auto": {
    "static": [
      {
        "type": "background",
        "kind": "mesh"
      }
    ],
    "captions": {
      "type": "captions",
      "mode": "karaoke",
      "maxWords": 4,
      "y": "=H*0.84",
      "className": "sg-cap"
    },
    "keywords": {
      "every": 3,
      "hold": 1.8,
      "element": {
        "type": "chip",
        "text": "{text}",
        "className": "sg-chip glass",
        "x": "=W/2",
        "y": "=H*0.69",
        "in": "rise"
      }
    },
    "hook": {
      "dur": 2.5,
      "element": {
        "type": "text",
        "text": "{text}",
        "className": "sg-hook",
        "y": "=H*0.06",
        "w": "=W*0.86",
        "in": "rise"
      }
    }
  },
  "finish": {
    "grade": "none"
  },
  "fps": 30
}